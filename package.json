{
  "name": "attunement",
  "version": "0.1.0",
  "private": true,
  "description": "Attunement — vertical slice of a browser-based third-person 3D MMORPG",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e/play.mjs",
    "assets:fetch": "node tools/assets/fetch.mjs",
    "assets:build": "node tools/assets/build.mjs",
    "assets:preview": "node tools/assets/preview.mjs",
    "capture": "node tools/capture.mjs",
    "profile": "node tools/profile.mjs",
    "assets:originals": "node tools/assets/originals/build.mjs",
    "assets:originals:check": "node tools/assets/originals/build.mjs --check"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "fflate": "^0.8.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5"
  }
}
